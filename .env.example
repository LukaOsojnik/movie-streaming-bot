TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USERS=

QB_HOST=localhost
QB_PORT=8080
# Must equal JELLYFIN_MEDIA_BASE/shared/movies (same directory Jellyfin reads from)
QB_DOWNLOAD_DIR=/home/youruser/jellyfin-media/shared/movies
# Must equal JELLYFIN_MEDIA_BASE/shared/tv-series
QB_TV_DIR=/home/youruser/jellyfin-media/shared/tv-series

# Internal URL for API calls (library refresh etc.)
JELLYFIN_URL=http://localhost:8096
# Shown to users by /jellyfin command; defaults to JELLYFIN_URL if blank
JELLYFIN_PUBLIC_URL=
JELLYFIN_API_KEY=
# Root of your media library — must contain shared/movies/ and shared/tv-series/ subdirs
JELLYFIN_MEDIA_BASE=/home/youruser/jellyfin-media
# Only needed if using the cloudflared service
CLOUDFLARED_CONFIG_DIR=/home/youruser/.cloudflared

TMDB_API_KEY=

OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_API_KEY=
